# 应用运行：手动设置独立入口令牌；空值关闭业务API，不生成默认凭据。
CONTEST_API_TOKEN=
CONTEST_LOG_LEVEL=INFO
CONTEST_LOG_DIR=logs
CONTEST_SESSION_TTL_SECONDS=1800
CONTEST_MAX_SESSIONS=128

# 数据库与查询资源：只填专用只读账号；JSON键匹配注册表connection_id。
CONTEST_DATABASE_URLS={}
CONTEST_STATEMENT_TIMEOUT_MS=15000
CONTEST_CONNECT_TIMEOUT_SECONDS=5
CONTEST_MAX_PLAN_COST=100000
CONTEST_MAX_RESULT_BYTES=1000000

# 模型：可信HTTPS Chat Completions基地址（含/v1时保留）；不自动选择提供方或重试。
CONTEST_LLM_PROVIDER_ID=contest
CONTEST_LLM_API_BASE_URL=
CONTEST_LLM_API_KEY=
CONTEST_LLM_MODEL=
CONTEST_LLM_MAX_OUTPUT_TOKENS=1024
CONTEST_LLM_TIMEOUT_SECONDS=30

# 存储：唯一真实注册表，路径相对项目根；不提交本地目录及数据。
CONTEST_REGISTRY_PATH=data/contest/registry.json
