# 应用运行配置。
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库与缓存：Windows PostgreSQL 17、Windows 本地 Redis 服务。
# 历史部署元信息，仅为保留本地配置结构；应用不读取以下五项。
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
REDIS_PORT=
DATABASE_URL=postgresql+psycopg://dkf_user:your_password@127.0.0.1:5432/dkf_agent
REDIS_URL=redis://127.0.0.1:6379/0

# 异步任务：使用同一 Redis 服务，按数据库编号分离消息与结果。
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# 模型与 LLM：真实密钥仅存放在本地 .env。
DEEPSEEK_API_KEY=

# OCR / 外部服务：MinerU 官方精准解析 V4；Token 仅填写在本地 .env。
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_IS_OCR=true
MINERU_SUBMIT_FILE_LIMIT_PER_MINUTE=50
MINERU_RESULT_QUERY_LIMIT_PER_MINUTE=1000
MINERU_DAILY_FILE_LIMIT=5000
MINERU_HIGH_PRIORITY_PAGE_LIMIT=1000
MINERU_UPLOAD_BATCH_MAX_FILES=50
MINERU_RATE_SAFETY_RATIO=0.9
MINERU_QUOTA_NAMESPACE=dkf-agent:mineru
MINERU_REQUEST_TIMEOUT_SECONDS=60
MINERU_POLL_INTERVAL_SECONDS=15
MINERU_JOB_TIMEOUT_SECONDS=7200
MINERU_MAX_RETRIES=5
MINERU_RESULT_MAX_MB=256
# 历史 OCR 配置，仅保留配置兼容性；当前应用不读取以下三项。
OCR_PROVIDER=mineru_cloud
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=

# 存储与可选功能：相对路径以项目根目录为基准；单文件大小按 MiB 计算。
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=50
