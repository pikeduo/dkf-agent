# 应用运行环境：development / test / production。
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# 本地 Docker Compose 默认连接；请在本地 .env 中替换用户名和密码。
DATABASE_URL=postgresql+psycopg://dkf_agent:change_me@localhost:5432/dkf_agent
REDIS_URL=redis://localhost:6379/0

# 外部服务密钥仅保存在本地 .env，绝不能提交到 Git。
DEEPSEEK_API_KEY=
OCR_PROVIDER=volcengine
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
