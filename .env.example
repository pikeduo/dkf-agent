# 应用运行配置。
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# 业务日志：UTF-8 中文文本摘要；API/Worker 合并，每个本机日期一个文件。
LOG_LEVEL=INFO
LOG_DIR=logs

# 数据库与缓存：Windows PostgreSQL 17、Windows 本地 Redis 服务。
# 历史部署元信息，仅为保留本地配置结构；应用不读取以下五项。
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
REDIS_PORT=
DATABASE_URL=postgresql+psycopg://dkf_user:your_password@127.0.0.1:5432/dkf_agent
REDIS_URL=redis://127.0.0.1:6379/0

# 异步任务：使用同一 Redis 服务，按数据库编号分离消息与结果。
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# 模型与 LLM：真实密钥仅存放在本地 .env。
# BGE-M3 仅使用本地目录，GPU Worker 单进程/并发 1；CPU 仅供显式 Service 对照。
EMBEDDING_MODEL_DIR=models/bge-m3
EMBEDDING_DEVICE=cuda:0
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=8192
EMBEDDING_USE_FP16=true
# BGE Reranker 在线同步批处理；8GB显存从batch=1～2开始，长输入不静默截断。
RERANKER_MODEL_DIR=models/bge-reranker-v2-m3
RERANKER_DEVICE=cuda:0
RERANKER_BATCH_SIZE=2
RERANKER_MAX_LENGTH=8192
RERANKER_USE_FP16=true
DEEPSEEK_API_KEY=

# OCR / 外部服务：MinerU 官方精准解析 V4；Token 仅填写在本地 .env。
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_IS_OCR=true
MINERU_SUBMIT_FILE_LIMIT_PER_MINUTE=50
MINERU_RESULT_QUERY_LIMIT_PER_MINUTE=1000
MINERU_DAILY_FILE_LIMIT=5000
MINERU_HIGH_PRIORITY_PAGE_LIMIT=1000
MINERU_UPLOAD_BATCH_MAX_FILES=50
MINERU_RATE_SAFETY_RATIO=0.9
MINERU_QUOTA_NAMESPACE=dkf-agent:mineru
MINERU_REQUEST_TIMEOUT_SECONDS=60
MINERU_POLL_INTERVAL_SECONDS=15
MINERU_JOB_TIMEOUT_SECONDS=7200
MINERU_MAX_RETRIES=5
MINERU_RESULT_MAX_MB=256
# 历史 OCR 配置，仅保留配置兼容性；当前应用不读取以下三项。
OCR_PROVIDER=mineru_cloud
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=

# 存储与可选功能：相对路径以项目根目录为基准；单文件大小按 MiB 计算。
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=50
# 解析缓存：API/Worker 共用可读写目录；只由用户任务生成结果，不自动清理。
PARSED_DIR=data/parsed
PARSE_CACHE_MAX_ENTRY_MB=768
# 阶段 14 向量结果本地存储，API/GPU Worker 共用；不自动清理，不写入 Git。
EMBEDDINGS_DIR=data/embeddings
# 本地切片：估算 token 目标与普通正文重叠；参数在提交时冻结。
CHUNK_SIZE=600
CHUNK_OVERLAP=80
# 完整性路由预检：PDF 面积为页面占比；超预检资源限制明确失败。
ROUTER_PDF_IMAGE_AREA_RATIO=0.01
ROUTER_PDF_DRAWING_AREA_RATIO=0.01
ROUTER_PDF_DRAWING_COUNT=6
ROUTER_PDF_MIN_TEXT_CHARS=20
ROUTER_PDF_MAX_PAGES=1000
ROUTER_PDF_MAX_LINES_PER_PAGE=2000
ROUTER_XML_PART_MAX_MB=16
# XLSX 局部视觉增强：auto 默认优先尝试，配置变更后重启 API/Worker。
HYBRID_XLSX_ENABLED=true
HYBRID_MAX_CANDIDATES=64
HYBRID_MAX_BUNDLE_PAGES=32
HYBRID_MIN_IMAGE_SIDE=32
HYBRID_MAX_IMAGE_PIXELS=16000000
HYBRID_MAX_IMAGE_MB=16
